    "forecast_comparisons": {
      "items": {
        "type": "string"
      },
      "maxItems": 6,
      "title": "Forecast Comparisons",
      "type": "array"
    },
    "selected_vs_rejected": {
      "maxLength": 1000,
      "title": "Selected Vs Rejected",
      "type": "string"
    },
    "execution_effects": {
      "maxLength": 700,
      "title": "Execution Effects",
      "type": "string"
    },
    "error_categories": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Error Categories",
      "type": "array"
    },
    "successes": {
      "items": {
        "type": "string"
      },
      "maxItems": 6,
      "title": "Successes",
      "type": "array"
    },
    "weaknesses": {
      "items": {
        "type": "string"
      },
      "maxItems": 6,
      "title": "Weaknesses",
      "type": "array"
    },
    "limitations": {
      "maxLength": 700,
      "title": "Limitations",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 24,
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "patches": {
      "items": {
        "$ref": "#/$defs/Patch"
      },
      "maxItems": 6,
      "title": "Patches",
      "type": "array"
    }
  },
  "required": [
    "summary",
    "scorecards",
    "forecast_comparisons",
    "selected_vs_rejected",
    "execution_effects",
    "error_categories",
    "successes",
    "weaknesses",
    "limitations",
    "evidence_ids",
    "patches"
  ],
  "title": "AnalystReview",
  "type": "object"
}
