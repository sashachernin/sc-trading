{
  "$defs": {
    "Patch": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "enum": [
            "researcher_a",
            "researcher_b",
            "manager"
          ],
          "title": "Target",
          "type": "string"
        },
        "operation": {
          "enum": [
            "add",
            "replace",
            "retire",
            "hypothesis",
            "parameter"
          ],
          "title": "Operation",
          "type": "string"
        },
        "lesson_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lesson Id"
        },
        "text": {
          "maxLength": 700,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "parameter": {
          "anyOf": [
            {
              "enum": [
                "minimum_confidence",
                "catalyst_weight"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parameter"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "expected_effect": {
          "maxLength": 500,
          "title": "Expected Effect",
          "type": "string"
        },
        "duration_weeks": {
          "maximum": 12,
          "minimum": 1,
          "title": "Duration Weeks",
          "type": "integer"
        },
        "success_metric": {
          "maxLength": 300,
          "title": "Success Metric",
          "type": "string"
        },
        "rollback_condition": {
          "maxLength": 300,
          "title": "Rollback Condition",
          "type": "string"
        },
        "expiry": {
          "title": "Expiry",
          "type": "string"
        }
      },
      "required": [
        "target",
        "operation",
        "lesson_id",
        "text",
        "parameter",
        "value",
        "evidence_ids",
        "confidence",
        "expected_effect",
        "duration_weeks",
        "success_metric",
        "rollback_condition",
        "expiry"
      ],
      "title": "Patch",
      "type": "object"
    },
    "Scorecard": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "researcher_a",
            "researcher_b",
            "manager",
            "analyst"
          ],
          "title": "Role",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "assessment": {
          "maxLength": 700,
          "title": "Assessment",
          "type": "string"
        }
      },
      "required": [
        "role",
        "score",
        "assessment"
      ],
      "title": "Scorecard",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "summary": {
      "maxLength": 2500,
      "title": "Summary",
      "type": "string"
    },
    "scorecards": {
