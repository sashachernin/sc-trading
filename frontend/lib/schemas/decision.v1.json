{
  "$defs": {
    "Allocation": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "percent": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 0.4,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Percent"
        },
        "rationale": {
          "maxLength": 700,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "amount",
        "percent",
        "rationale"
      ],
      "title": "Allocation",
      "type": "object"
    },
    "Rejection": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 700,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "rationale"
      ],
      "title": "Rejection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "reviewed_ids": {
      "items": {
        "type": "string"
      },
      "title": "Reviewed Ids",
      "type": "array"
    },
    "allocations": {
      "items": {
        "$ref": "#/$defs/Allocation"
      },
      "maxItems": 6,
      "title": "Allocations",
      "type": "array"
    },
    "rejections": {
      "items": {
        "$ref": "#/$defs/Rejection"
      },
      "maxItems": 6,
      "title": "Rejections",
      "type": "array"
    },
    "retained_cash": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Retained Cash"
    },
    "hold_cash": {
      "title": "Hold Cash",
      "type": "boolean"
    },
    "summary": {
      "maxLength": 1200,
      "title": "Summary",
      "type": "string"
    },
    "risk_considerations": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Risk Considerations",
      "type": "array"
    },
    "uncertainty": {
      "maxLength": 500,
      "title": "Uncertainty",
      "type": "string"
    }
  },
  "required": [
    "reviewed_ids",
    "allocations",
    "rejections",
    "retained_cash",
    "hold_cash",
    "summary",
    "risk_considerations",
    "uncertainty"
  ],
  "title": "ManagerDecision",
  "type": "object"
}
