{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "ticker": {
          "pattern": "^[A-Z][A-Z0-9.]{0,9}$",
          "title": "Ticker",
          "type": "string"
        },
        "company": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Company",
          "type": "string"
        },
        "rank": {
          "maximum": 3,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "max_allocation": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 0.4,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Max Allocation"
        },
        "expected_return": {
          "maximum": 2,
          "minimum": -1,
          "title": "Expected Return",
          "type": "number"
        },
        "downside": {
          "maximum": 0,
          "minimum": -1,
          "title": "Downside",
          "type": "number"
        },
        "probability_profit": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability Profit",
          "type": "number"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "thesis": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Thesis",
          "type": "string"
        },
        "catalysts": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Catalysts",
          "type": "array"
        },
        "risks": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Risks",
          "type": "array"
        },
        "invalidation": {
          "maxLength": 500,
          "title": "Invalidation",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Assumptions",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "ticker",
        "company",
        "rank",
        "max_allocation",
        "expected_return",
        "downside",
        "probability_profit",
        "confidence",
        "thesis",
        "catalysts",
        "risks",
        "invalidation",
        "assumptions",
        "evidence_ids"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "ResearchSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^web-[a-zA-Z0-9_-]{1,60}$",
          "title": "Id",
          "type": "string"
        },
        "url": {
          "maxLength": 2000,
          "title": "Url",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published At"
        },
        "finding": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        }
      },
      "required": [
        "id",
        "url",
        "title",
        "published_at",
        "finding"
      ],
      "title": "ResearchSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "role": {
      "enum": [
        "researcher_a",
        "researcher_b"
      ],
      "title": "Role",
      "type": "string"
    },
    "cutoff": {
      "title": "Cutoff",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "maxItems": 3,
      "title": "Candidates",
      "type": "array"
    },
    "abstention_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Abstention Reason"
    },
    "research_summary": {
      "default": "",
      "maxLength": 2500,
      "title": "Research Summary",
      "type": "string"
    },
    "investigated_tickers": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Investigated Tickers",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/ResearchSource"
      },
      "maxItems": 12,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "role",
    "cutoff",
    "snapshot_id",
    "candidates",
    "abstention_reason"
  ],
  "title": "Research",
  "type": "object"
}
