[Unit]
Description=AI Investment Lab durable PAPER trading worker
After=network-online.target postgresql.service ai-investment-lab-model.service
Wants=network-online.target
Requires=ai-investment-lab-model.service

[Service]
Type=simple
User=aiinvest
Group=aiinvest
WorkingDirectory=/opt/ai-investment-lab
EnvironmentFile=/etc/ai-investment-lab/engine.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ai-investment-lab/.venv/bin/python -m app.jobs.worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-investment-lab
# Production local materialization must be disabled; engine source is immutable.
MemoryMax=2G
TasksMax=96
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
