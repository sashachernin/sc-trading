[Unit]
Description=AI Investment Lab isolated unprivileged model gateway
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=ubuntu
Group=aiinvest
ExecStart=/usr/bin/python3 /usr/local/libexec/lab-model-gateway.py
RuntimeDirectory=ai-investment-lab-model
RuntimeDirectoryMode=0750
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=tmpfs
ProtectSystem=strict
BindPaths=/home/ubuntu/.codex:/run/lab-codex-auth
ReadWritePaths=/run/ai-investment-lab-model /run/lab-codex-auth
InaccessiblePaths=/etc/ai-investment-lab /var/lib/ai-investment-lab /opt/ai-investment-lab
UMask=0077
MemoryMax=3G
TasksMax=192
LimitNOFILE=1024
[Install]
WantedBy=multi-user.target
