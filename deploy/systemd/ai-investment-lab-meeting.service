[Unit]
Description=Enqueue AI Investment Lab meeting workflow
After=postgresql.service
[Service]
Type=oneshot
User=aiinvest
Group=aiinvest
WorkingDirectory=/opt/ai-investment-lab
EnvironmentFile=/etc/ai-investment-lab/engine.env
ExecStart=/usr/bin/flock -n /var/lib/ai-investment-lab/locks/meeting.lock /opt/ai-investment-lab/.venv/bin/python -m app.jobs.run_sunday_meeting
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ai-investment-lab
UMask=0077
