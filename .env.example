# Synthetic defaults. Production must use PostgreSQL, Alpaca and real Codex.
DATABASE_URL=sqlite:///state/lab.db
EXPERIMENT_ID=synthetic-demo
EXPERIMENT_START=2026-09-14
MARKET_PROVIDER=synthetic
CODEX_MODE=fake
CODEX_BINARY=codex
CODEX_MODEL_RESEARCHER_A=gpt-6.1-sol
CODEX_MODEL_RESEARCHER_B=gpt-6.1-sol
CODEX_MODEL_MANAGER=gpt-6.1-sol
CODEX_MODEL_ANALYST=gpt-6.1-sol
CODEX_REASONING=medium
CODEX_AUTH_HOME=/var/lib/ai-investment-lab/codex-auth
STATE_DIR=state
LEARNING_MODE=auto_bounded
SITE_VISIBILITY=private
PRIVATE_ACCESS_VERIFIED=false
PUBLISHER_CHECKOUT=
PUBLISH_BRANCH=main
DEPLOYMENT_URL=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex
UNIVERSE=AAPL,MSFT,NVDA,AMZN,GOOGL,META
# Native service keeps /opt immutable; use false in production.
MATERIALIZE_LOCAL_EXPORT=true
ALPACA_ASSET_BASE_URL=https://paper-api.alpaca.markets
